//
//  Tape.xcconfig
//
//  The only file to edit before running Tape on your own iPhone.
//
//  TAPE_BUNDLE_PREFIX  Something unique to you, e.g. com.yourname. The bundle
//                      IDs and the App Group are built from it, so they always match.
//  DEVELOPMENT_TEAM    Your Team ID (Xcode > Settings > Accounts), or leave it
//                      empty and pick the team in Signing & Capabilities.
//
//  The Simulator needs neither.
//

TAPE_BUNDLE_PREFIX = com.example
DEVELOPMENT_TEAM =

// The app and the widget share settings (the plot size, decimals) through this group.
TAPE_APP_GROUP = group.$(TAPE_BUNDLE_PREFIX).tape

// Optional, git-ignored overrides (your team and prefix) so they stay out of the repo.
#include? "Local.xcconfig"
